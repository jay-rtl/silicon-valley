---
import Layout from '../layouts/Layout.astro';
import {url} from '../data';
---
<Layout title="Silicon Valley Service Areas" description="Construction and remodeling serving San Jose, Santa Clara, Sunnyvale, Mountain View, and Palo Alto."><section class="page-heading section"><p class="eyebrow">CLOSE TO HOME</p><h1>Rooted in<br/><em>the Valley.</em></h1><p class="page-lead">Construction and remodeling across five core Silicon Valley communities listed on the company website.</p></section><section class="section areas-layout"><div class="valley-map" aria-label="Schematic service area map, not to scale"><span class="map-grid"></span><span class="map-city palo">Palo Alto <b>●</b></span><span class="map-city mountain">Mountain View <b>●</b></span><span class="map-city sunny">Sunnyvale <b>●</b></span><span class="map-city santa">Santa Clara <b>●</b></span><span class="map-city jose">San Jose <b>●</b></span><small>SILICON VALLEY / SCHEMATIC · NOT TO SCALE</small></div><div class="area-list">{['San Jose','Santa Clara','Sunnyvale','Mountain View','Palo Alto'].map((city,i)=><a href={url(`contact/?city=${encodeURIComponent(city)}`)}><span>0{i+1}</span><h2>{city}</h2><span>↗</span></a>)}<p>Nearby? Contact the company to confirm availability for your address.</p></div></section></Layout>
