---
import Layout from '../../layouts/Layout.astro';
import {projects,url,img} from '../../data';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
const {project:p}=Astro.props; const next=projects[(projects.indexOf(p)+1)%projects.length];
---
<Layout title={p.title} description={p.text}><section class="project-heading section"><a class="eyebrow" href={url('projects/')}>← BACK TO THE COLLECTION</a><h1>{p.title}</h1><p>{p.category}</p></section><figure class="project-full"><img src={img(p.image)} alt={p.title+' visual reference'} width="2000" height="1300"/><figcaption>Visual reference · No completed company project claim</figcaption></figure><section class="section service-body"><div><p class="eyebrow">THE STUDY</p><h2>Look closer.<br/><em>Imagine more.</em></h2><p class="body-copy">{p.text}</p></div><div class="scope"><p class="eyebrow">DESIGN CONSIDERATIONS</p>{p.details.map((d,i)=><div><span>0{i+1}</span><h3>{d}</h3></div>)}<a class="text-link" href={url('contact/')}>Discuss a space of your own ↗</a></div></section><section class="next-project section"><p class="eyebrow">NEXT REFERENCE</p><a href={url(`projects/${next.slug}/`)}>{next.title} ↗</a></section></Layout>
