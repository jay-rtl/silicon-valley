---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Reviews from '../components/Reviews.astro';
import Comparison from '../components/Comparison.astro';
import {url,img,steps} from '../data';
const panels = [['Custom Home Construction','custom-home-construction','exterior.jpg'],['Remodeling & Renovation','whole-home-remodeling','hero.jpg'],['Kitchen & Bathroom','kitchen-remodeling','kitchen.jpg'],['Commercial Construction','commercial-construction','hero.jpg'],['Roofing & Restoration','roofing','home.webp'],['Additions & ADUs','adu-construction','exterior.jpg']];
---
<Layout>
<div class="preloader" aria-hidden="true"><div class="draft-line"></div><img src={url('assets/branding/original-logo.png')} width="250" height="73" alt=""/><span>VISION. PRECISION. POSSIBILITY.</span></div>
<section class="hero"><img class="hero-image" src={img('exterior.jpg')} alt="Modern residence with a courtyard and illuminated living spaces — architectural reference" width="2400" height="1600" fetchpriority="high"/><div class="hero-overlay"></div><div class="hero-top"><span>CALIFORNIA BUILT. SILICON VALLEY ROOTED.</span><span>RESIDENTIAL & COMMERCIAL</span></div><div class="hero-content"><p class="eyebrow"><span class="small-line"></span> THOUGHTFUL CONSTRUCTION. LASTING IMPACT.</p><h1><span>Where vision</span><span>becomes <em>structure.</em></span></h1><div class="hero-bottom"><p>Exceptional construction and remodeling<br/>across Silicon Valley.</p><div class="button-row"><a class="button light" href={url('projects/')}>Explore our projects <span>↗</span></a><a class="text-link white" href={url('contact/')}>Request a free estimate <span>↗</span></a></div></div></div><div class="hero-foot"><a href="#introduction">SCROLL TO DISCOVER <span>↓</span></a><span>01 — THE ART OF BUILDING</span><span>ARCHITECTURAL REFERENCE · UNSPLASH</span></div></section>
<div class="trust-strip"><span>PUBLISHED CA LICENSE <strong>#1033491</strong></span><span class="strip-line"></span><p>Local knowledge. Considered craftsmanship.</p><span>SERVING SILICON VALLEY <span class="red-dot"></span></span></div>
<section class="intro section" id="introduction"><div class="intro-copy"><p class="eyebrow">01 / THE WAY WE BUILD</p><h2>Built with precision.<br/>Designed for <em>living.</em></h2><p class="body-copy">A great space begins with a clear vision. Silicon Valley General Builder Contractor brings construction and remodeling services to homes and businesses across the Valley.</p><p class="body-copy muted">From a kitchen reimagined to a home built from the ground up, every conversation starts with the way you want to live.</p><a class="text-link" href={url('about/')}>Get to know our approach <span>↗</span></a></div><figure class="intro-photo reveal-image"><img src={img('hero.jpg')} alt="Thoughtful natural materials in a contemporary interior — architectural reference" width="1200" height="800" loading="lazy"/><figcaption><span>DETAILS MAKE THE DIFFERENCE.</span><span>REFERENCE / 01</span></figcaption><span class="photo-tag">SPACE. LIGHT. MATERIAL.</span></figure></section>
<section class="services-story section dark"><div class="section-top"><p class="eyebrow">02 / EXPERTISE, BUILT AROUND YOU</p><a class="text-link white" href={url('services/')}>All services <span>↗</span></a></div><div class="split-heading"><h2>From possibility<br/>to <em>place.</em></h2><p>One considered approach.<br/>A full spectrum of construction.</p></div><div class="service-showcase"><div class="service-visual"><img id="service-image" src={img('exterior.jpg')} alt="Architectural service reference" width="1100" height="1000" loading="lazy"/><span>VISUAL REFERENCES · PROJECT PROVENANCE UNVERIFIED</span></div><div class="service-list">{panels.map(([title,slug,photo],i)=><a href={url(`services/${slug}/`)} data-service-image={img(photo)}><small>0{i+1}</small><h3>{title}</h3><span>↗</span></a>)}</div></div></section>
<section class="featured section"><div class="section-top"><p class="eyebrow">03 / SPACES THAT INSPIRE</p><a class="text-link" href={url('projects/')}>Explore the collection <span>↗</span></a></div><div class="split-heading"><h2>Considered spaces.<br/><em>Enduring</em> impressions.</h2><p>A collection of architectural references and source-site imagery. Inspiration for what comes next, with provenance made clear.</p></div><Projects/></section>
<section class="architecture section dark" id="architecture"><div class="architecture-copy"><p class="eyebrow">PRECISION AT EVERY STAGE</p><h2>From concept<br/>to <em>creation.</em></h2><p>Every lasting space starts with a framework. Explore how structure, volume, and material come together.</p><p class="caption">Interactive conceptual model · Not a completed company project</p><label class="model-control">BUILD PROGRESS <input id="build-progress" type="range" min="0" max="100" value="55"/><span id="build-stage">02 / STRUCTURE</span></label></div><div class="model-wrap"><div id="house-scene" role="img" aria-label="Interactive conceptual modern house construction model"><div class="model-fallback"><img src={img('exterior.jpg')} alt="Architectural reference fallback" loading="lazy"/><span>Conceptual architecture study</span></div></div><span class="model-caption">CONCEPT MODEL 001 <span>DRAG TO ROTATE ↔</span></span></div></section>
<Comparison/>
<section class="process section dark"><div class="section-top"><p class="eyebrow">05 / A CLEAR PATH FORWARD</p><a class="text-link white" href={url('our-process/')}>Discover the process ↗</a></div><h2>Your vision.<br/>A thoughtful <em>journey.</em></h2><div class="process-grid">{steps.map(([title,lead],i)=><a href={url(`our-process/#step-${i+1}`)}><span class="step-number">0{i+1}</span><span class="process-line"></span><h3>{title}</h3><p>{lead}</p></a>)}</div></section>
<Reviews/>
<div class="area-ribbon"><span>ROOTED IN THE VALLEY</span><a href={url('service-areas/')}>San Jose <b>·</b> Santa Clara <b>·</b> Sunnyvale <b>·</b> Mountain View <b>·</b> Palo Alto ↗</a></div>
</Layout>
